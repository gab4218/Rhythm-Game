{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ed7d92feb91e44d9a71aee7a3b4af75d",
    "m_Title": "GetMainLightDir",
    "m_Content": "Subgraph usado para obtener la direccion de la luz principal de la escena, dado que el propio de Unity no funciona (al menos en mi experiencia). Usado para el calculo del Lambertian Diffuse (shading matte) (nivel de luz = producto escalar de la direccion de la luz y el vector normal de la superficie), en este caso. Adaptado de: https://www.youtube.com/watch?v=bWRnl-CApk4",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2046.0,
        "y": 805.0,
        "width": 200.0,
        "height": 196.0
    },
    "m_Group": {
        "m_Id": "150c0334ffff4b8d8e9a758b674dc714"
    }
}

